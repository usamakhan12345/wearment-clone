{
  "name": "shemiproduct",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "import:wearments": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-wearments/index.ts",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.15.0",
    "next": "^16.4.6",
    "payload": "3.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
